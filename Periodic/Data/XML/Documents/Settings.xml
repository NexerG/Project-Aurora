<Window xmlns="http://arctisaurora/AuroraUITypes"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://arctisaurora/UI ../Schemas/UITypeSchema.xsd"
        Width="720" Height="480" WindowingMode="WindowSize" ContentScalingMode="Vertical" ColorHex="#252525">

	<WindowFrame ColorHex="#252525">
	<StackPanel Orientation="Vertical" ColorHex="#252525">

		<TitleBar Orientation="Horizontal" Height="32" ColorHex="#141414">
			<Label Text="Settings" FontSize="14" Width="120" Height="32" ColorHex="#9D9D9D"/>
			<Panel WidthStar="1" Height="32" ColorHex="#141414" BubbleClick="true"/>
			<Button Width="46" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A" onRelease="Window.Minimize">
				<Label Text="-" FontSize="16" ColorHex="#CCCCCC"/>
			</Button>
			<Button Width="46" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A" onRelease="Window.MaximizeRestore">
				<Label Text="[]" FontSize="16" ColorHex="#CCCCCC"/>
			</Button>
			<Button Width="46" Height="32" ColorHex="#141414" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Label Text="X" FontSize="16" ColorHex="#CCCCCC"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Horizontal" HeightStar="1" ColorHex="#252525">

			<StackPanel Name="Categories" Orientation="Vertical" Width="160" ColorHex="#1E1E1E" Padding="8" Spacing="4"/>

			<StackPanel Orientation="Vertical" WidthStar="1" ColorHex="#252525" Padding="12" Spacing="8">
				<ScrollableControl HeightStar="1" ColorHex="#252525">
					<StackPanel Name="Rows" Orientation="Vertical" Spacing="6" ColorHex="#252525"/>
				</ScrollableControl>

				<StackPanel Orientation="Horizontal" Height="30" ColorHex="#252525">
					<Panel WidthStar="1" Height="30" ColorHex="#252525"/>
					<Button Width="90" Height="30" ColorHex="#3A3A3A" HoverColorHex="#4A4A4A" PressColorHex="#2A2A2A"
							CornerRadius="4" onRelease="Settings.Save">
						<Label Text="Save" FontSize="14" ColorHex="#CCCCCC"/>
					</Button>
				</StackPanel>
			</StackPanel>

		</StackPanel>
	</StackPanel>
	</WindowFrame>
</Window>
