<Window xmlns="http://arctisaurora/AuroraUITypes"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://arctisaurora/UI ../Schemas/UITypeSchema.xsd"
        Width="1280" Height="720" WindowingMode="WindowSize" ContentScalingMode="Vertical" ColorHex="#1e1e1e">

	<StackPanel Orientation="Vertical" ColorHex="#1e1e1e">

		<TitleBar Orientation="Horizontal" Height="32" ColorHex="#141414">
			<Label Text="Periodic" FontSize="14" Width="120" Height="32"/>
			<Panel WidthStar="1" Height="32" ColorHex="#141414" BubbleClick="true"/>
			<Button Width="46" Height="32" onClick="Window.Minimize">
				<Label Text="-" FontSize="16"/>
			</Button>
			<Button Width="46" Height="32" onClick="Window.MaximizeRestore">
				<Label Text="[]" FontSize="16"/>
			</Button>
			<Button Width="46" Height="32" onClick="Window.Close">
				<Label Text="X" FontSize="16"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Horizontal" HeightStar="1" ColorHex="#1e1e1e">
			<VaultBrowser Width="220" ColorHex="#171717"/>
			<DocumentEditor WidthStar="1"/>
		</StackPanel>
	</StackPanel>
</Window>
