<Window xmlns="http://arctisaurora/AuroraUITypes"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://arctisaurora/UI ../../Schemas/UITypeSchema.xsd"
        Width="1280" Height="720" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#1e1e1e" ContextMenu="window">

	<WindowFrame ColorHex="#1e1e1e">
	<StackPanel Orientation="Vertical" ColorHex="#1e1e1e">

		<TitleBar Orientation="Horizontal" Height="32" ColorHex="#141414" Gradient="titlebar">
			<MenuButton Caption="Periodic" ContextMenu="periodic" Width="72" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A"/>
			<MenuButton Caption="File" ContextMenu="file" Width="48" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A"/>
			<MenuButton Caption="Edit" ContextMenu="edit" Width="48" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A"/>
			<MenuButton Caption="View" ContextMenu="view" Width="48" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A"/>
			<Panel WidthStar="1" Height="32" ColorHex="#141414" BubbleClick="true"/>
			<Button Width="46" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A" onRelease="Window.Minimize">
				<Icon Set="default" Icon="minimize" Width="14" Height="14" ColorHex="#CCCCCC"/>
			</Button>
			<Button Width="46" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A" onRelease="Window.MaximizeRestore">
				<Icon Set="default" Icon="maximize" Width="18" Height="18" ColorHex="#CCCCCC"/>
			</Button>
			<Button Width="46" Height="32" ColorHex="#141414" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Icon Set="default" Icon="close" Width="14" Height="14" ColorHex="#CCCCCC"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Horizontal" HeightStar="1" ColorHex="#1e1e1e">
			<StackPanel Orientation="Vertical" Width="220" MinWidth="120" ColorHex="#171717">
				<VaultBrowser Name="Browser" HeightStar="1" ColorHex="#171717" Padding="8"/>
				<Button Height="28" HorizontalAlignment="Stretch" ColorHex="#171717" HoverColorHex="#232323" PressColorHex="#2D2D2D" onRelease="Settings.Open">
					<Label Text="Settings" FontSize="13" ColorHex="#9D9D9D"/>
				</Button>
			</StackPanel>
			<Splitter Width="5"/>
			<SplitView Orientation="Horizontal" WidthStar="1">
				<EditableTabs Name="Tabs" Width="525" MinWidth="120" ColorHex="#1e1e1e" ContextMenu="view"
							  TabHeight="28" TabWidth="180"
							  TabColorHex="#252525" ActiveTabColorHex="#1e1e1e" TabHoverColorHex="#2F2F2F"
							  TearOffDocument="tab-window">
					<TabItem Header="SampleNote">
						<DocumentEditor Source="../../Notes/SampleNote.xml"/>
					</TabItem>
				</EditableTabs>
				<Splitter Width="5"/>
				<EditableTabs Name="TabsRight" WidthStar="1" MinWidth="120" ColorHex="#1e1e1e" ContextMenu="view"
							  TabHeight="28" TabWidth="180"
							  TabColorHex="#252525" ActiveTabColorHex="#1e1e1e" TabHoverColorHex="#2F2F2F"
							  TearOffDocument="tab-window">
					<TabItem Header="Keybinds">
						<DocumentEditor Source="../../Notes/Reference/Keybinds.xml"/>
					</TabItem>
				</EditableTabs>
			</SplitView>
		</StackPanel>
	</StackPanel>
	</WindowFrame>
</Window>
