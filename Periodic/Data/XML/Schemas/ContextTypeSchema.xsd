<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:types="http://arctisaurora/AuroraContextTypes" xmlns:actions="http://arctisaurora/ActionDependencies" xmlns:allTypes="http://arctisaurora/AuroraTypes" elementFormDefault="qualified" targetNamespace="http://arctisaurora/AuroraContextTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="actionSchema.xsd" namespace="http://arctisaurora/ActionDependencies" />
  <xs:import schemaLocation="AllTypesSchema.xsd" namespace="http://arctisaurora/AuroraTypes" />
  <xs:element name="ActiveContext" type="types:ActiveContext" />
  <xs:complexType name="ActiveContext">
    <xs:sequence />
  </xs:complexType>
  <xs:element name="Context" type="types:Context" />
  <xs:complexType name="Context">
    <xs:sequence />
    <xs:attribute name="Name" type="xs:string" />
    <xs:attribute name="Type" type="xs:string" />
    <xs:attribute name="From" type="xs:string" />
  </xs:complexType>
  <xs:element name="Contexts" type="types:Contexts" />
  <xs:complexType name="Contexts">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>