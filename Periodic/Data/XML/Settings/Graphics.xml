<?xml version="1.0" encoding="utf-8"?>
<UserSettings xmlns="http://arctisaurora/AuroraSettingsTypes"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://arctisaurora/AuroraSettingsTypes ../Schemas/SettingsTypeSchema.xsd">

  <!-- Periodic's build decisions about the engine's Graphics category. Values are deliberately
       absent: a setting named here stops tracking the engine's own default, so only scope is
       declared and everything else stays as GraphicsSettings declares it.

       VSync is App because a note editor has no reason to put a frame-pacing option in front of
       whoever is writing in it. Device, monitor and window stay User — those are the reader's to
       choose, and the write root is where their choices land. -->
  <Graphics>
    <VSync Scope="App"/>
  </Graphics>

</UserSettings>
