<?xml version="1.0" encoding="utf-8"?>
<NextWindow Width="1400" Height="900" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#FBFAF8">

	<NextWindowFrame ColorHex="#FBFAF8">
	<NextStackPanel Orientation="Vertical" ColorHex="#FBFAF8">

		<NextTitleBar Orientation="Horizontal" Height="32" ColorHex="#EBEAE5">
			<NextLabel Text="Carbon" FontSize="14" Width="80" Height="32" ColorHex="#5F5D56"/>
			<NextPanel WidthStar="1" Height="32" ColorHex="#EBEAE5"/>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.Minimize">
				<NextIcon Set="default" Icon="minimize" Width="14" Height="14" ColorHex="#5F5D56"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.MaximizeRestore">
				<NextIcon Set="default" Icon="maximize" Width="18" Height="18" ColorHex="#5F5D56"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<NextIcon Set="default" Icon="close" Width="14" Height="14" ColorHex="#5F5D56"/>
			</NextButton>
		</NextTitleBar>

		<NextStackPanel Orientation="Horizontal" HeightStar="1" ColorHex="#FBFAF8">

			<NextStackPanel Orientation="Vertical" Width="420" MinWidth="220" ColorHex="#F2F1ED" Padding="8" Spacing="8">
				<NextButton Height="28" HorizontalAlignment="Stretch" ColorHex="#E3E1D9" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"
							CornerRadius="4" onRelease="Carbon.LoadCapture">
					<NextLabel Text="Load XML" FontSize="13" ColorHex="#5F5D56"/>
				</NextButton>
				<NextStackPanel Orientation="Horizontal" Height="28" HorizontalAlignment="Stretch" Spacing="8" ColorHex="#F2F1ED">
					<NextButton WidthStar="1" Height="28" ColorHex="#E3E1D9" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"
								CornerRadius="4" onRelease="Carbon.PinBaseline">
						<NextLabel Text="Pin as baseline" FontSize="13" ColorHex="#5F5D56"/>
					</NextButton>
					<NextButton WidthStar="1" Height="28" ColorHex="#E3E1D9" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"
								CornerRadius="4" onRelease="Carbon.ClearBaseline">
						<NextLabel Text="Clear baseline" FontSize="13" ColorHex="#5F5D56"/>
					</NextButton>
				</NextStackPanel>
				<NextSessionList Name="Sessions" Height="150" ColorHex="#F2F1ED"
								 RowColorHex="#E3E1D9" RowHoverColorHex="#DCDAD3" RowPressColorHex="#D0CEC6"
								 NameColorHex="#23221E" SelectedColorHex="#3A3833" DetailColorHex="#918F87"
								 ThumbColorHex="#D7D5CD" ThumbHoverColorHex="#C9C6BC" ThumbPressColorHex="#BAB7AC"/>
				<NextZoneTable Name="Zones" HeightStar="1" ColorHex="#F2F1ED"
							   Indent="14" SwatchWidth="3" DeltaWidth="100" SeparatorColorHex="#DCDAD3"
							   SlowerColorHex="#B0452E" FasterColorHex="#5B7F45"
							   DepthColorsHex="#B8A48C,#C4A882,#A8B49C,#B0A8BC,#C0B098"
							   HeaderColorHex="#3A3833" ZoneColorHex="#23221E" DetailColorHex="#918F87"
							   ThumbColorHex="#D7D5CD" ThumbHoverColorHex="#C9C6BC" ThumbPressColorHex="#BAB7AC"/>
			</NextStackPanel>

			<NextSplitter Width="5" ColorHex="#E6E4DE" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"/>

			<NextStackPanel Orientation="Vertical" WidthStar="1" ColorHex="#FBFAF8" Padding="8" Spacing="8">
				<NextFrameStrip Name="Strip" Height="140" ColorHex="#F5F4F0" Padding="8"
								BarColorHex="#C9C6BC" SelectedBarColorHex="#C4622B" LabelColorHex="#918F87"/>
				<NextSpanChart Name="Flame" Mode="Frame" HeightStar="1" MinHeight="10" ClipToBounds="true" ColorHex="#F5F4F0" Padding="8"
							   RulerHeight="18" TickColorHex="#C9C6BC" RulerLabelColorHex="#918F87"
							   FrameColorHex="#E3E1D9" SpanLabelColorHex="#2C2B26" LaneLabelColorHex="#918F87"/>

				<NextSplitter Height="5" ColorHex="#E6E4DE" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"/>

				<NextSpanChart Name="Timeline" Mode="Timeline" HeightStar="2" MinHeight="10" ClipToBounds="true" ColorHex="#F5F4F0" Padding="8"
							   MaxLabels="80" RulerHeight="18" TickColorHex="#C9C6BC" RulerLabelColorHex="#918F87"
							   FrameColorHex="#E3E1D9" SpanLabelColorHex="#2C2B26" LaneLabelColorHex="#918F87"
							   TrackColorHex="#EBEAE5" ThumbColorHex="#D7D5CD" ThumbHoverColorHex="#C9C6BC" ThumbPressColorHex="#BAB7AC"/>
			</NextStackPanel>

		</NextStackPanel>

	</NextStackPanel>
	</NextWindowFrame>
</NextWindow>
