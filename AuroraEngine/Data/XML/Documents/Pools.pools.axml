<EnginePools xmlns="http://arctisaurora/AuroraDataPoolsTypes"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://arctisaurora/AuroraDataPoolsTypes ../Schemas/DataPoolsTypeSchema.xsd">

	<Pool Name="UIElements" Capacity="1024" Ordered="true" SortAction="UI.ElementOrder" Growth="Multiplicative" GrowthValue="2">
		<Component Type="ArrangeData"/>
		<Component Type="LayoutNode"/>
		<Component Type="VulkanControl"/>
	</Pool>

	<Pool Name="UIQuads" Capacity="1024" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="ControlGeometry"/>
		<Component Type="VulkanControl"/>
	</Pool>

	<Pool Name="Entities" Capacity="1024" Ordered="false" Growth="Multiplicative" GrowthValue="2">
		<Component Type="TransformData"/>
	</Pool>

	<Pool Name="Paints" Capacity="1024" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="GpuPaint"/>
	</Pool>

	<Pool Name="Gradients" Capacity="32" Ordered="false" Growth="Additive" GrowthValue="32" Handles="false">
		<Component Type="GpuGradient"/>
	</Pool>

	<Pool Name="Effects" Capacity="32" Ordered="false" Growth="Additive" GrowthValue="32" Handles="false">
		<Component Type="GpuEffect"/>
	</Pool>

	<Pool Name="Animations" Capacity="256" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="AnimationTrack"/>
		<Component Type="TweenParams"/>
		<Component Type="KeyParams"/>
		<Component Type="SpringParams"/>
		<Component Type="TrackCold"/>
	</Pool>

	<Pool Name="Signals" Capacity="64" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="SignalValue"/>
		<Component Type="SignalLife"/>
	</Pool>

	<Pool Name="Keyframes" Capacity="256" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="Keyframe"/>
	</Pool>

	<Pool Name="LayoutDirty" Capacity="256" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="DirtyLayout"/>
	</Pool>

	<Pool Name="AnimationDone" Capacity="64" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="FinishedTrack"/>
	</Pool>

	<Pool Name="AnimationBindings" Capacity="256" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="TrackBinding"/>
	</Pool>

	<Pool Name="AnimationAwake" Capacity="256" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="AwakeTrack"/>
	</Pool>

	<Pool Name="PaintFades" Capacity="64" Ordered="false" Growth="Multiplicative" GrowthValue="2" Handles="false">
		<Component Type="SlotFade"/>
	</Pool>

</EnginePools>