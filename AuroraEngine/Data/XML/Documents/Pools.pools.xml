<EnginePools xmlns="http://arctisaurora/AuroraDataPoolsTypes"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://arctisaurora/AuroraDataPoolsTypes ../Schemas/DataPoolsTypeSchema.xsd">

	<Pool Name="UIControls" System="Main" Capacity="1024" Ordered="true" SortAction="UI.DFSOrder" Growth="Multiplicative" GrowthValue="2">
		<Component Type="TransformData"/>
		<Component Type="ControlData"/>
		<Component Type="GpuTransform"/>
	</Pool>

	<Pool Name="UIElements" System="Main" Capacity="1024" Ordered="true" SortAction="UI.NextElementOrder" Growth="Multiplicative" GrowthValue="2">
		<Component Type="ArrangeData"/>
	</Pool>

	<Pool Name="VulkanControls" System="Main" Capacity="4096" Ordered="true" SortAction="UI.NextControlOrder" Growth="Multiplicative" GrowthValue="2">
		<Component Type="ControlGeometry"/>
		<Component Type="VulkanControlData"/>
	</Pool>

	<Pool Name="Entities" System="Main" Capacity="1024" Ordered="false" Growth="Multiplicative" GrowthValue="2">
		<Component Type="TransformData"/>
	</Pool>

</EnginePools>