<EnginePools xmlns="http://arctisaurora/AuroraDataPoolsTypes"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://arctisaurora/AuroraDataPoolsTypes ../Schemas/DataPoolsTypeSchema.xsd">

	<Pool Name="UIElements" System="Main" Capacity="1024" Ordered="true" SortAction="UI.ElementOrder" Growth="Multiplicative" GrowthValue="2">
		<Component Type="ArrangeData"/>
	</Pool>

	<Pool Name="UIQuads" System="Main" Capacity="1024" Ordered="false" Growth="Additive" GrowthValue="512">
		<Component Type="ControlGeometry"/>
		<Component Type="VulkanControl"/>
	</Pool>

	<Pool Name="Entities" System="Main" Capacity="1024" Ordered="false" Growth="Multiplicative" GrowthValue="2">
		<Component Type="TransformData"/>
	</Pool>

</EnginePools>