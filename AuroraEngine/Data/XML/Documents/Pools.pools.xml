<EnginePools xmlns="http://arctisaurora/AuroraDataPoolsTypes"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://arctisaurora/AuroraDataPoolsTypes ../Schemas/DataPoolsTypeSchema.xsd">

	<Pool Name="UIElements" Capacity="1024" Ordered="true" SortAction="UI.ElementOrder" Growth="Multiplicative" GrowthValue="2">
		<Component Type="ArrangeData"/>
	</Pool>

	<Pool Name="UIQuads" Capacity="1024" Ordered="false" Growth="Additive" GrowthValue="512">
		<Component Type="ControlGeometry"/>
		<Component Type="VulkanControl"/>
	</Pool>

	<Pool Name="Entities" Capacity="1024" Ordered="false" Growth="Multiplicative" GrowthValue="2">
		<Component Type="TransformData"/>
	</Pool>

	<Pool Name="Paints" Capacity="1024" Ordered="false" Growth="Additive" GrowthValue="512">
		<Component Type="GpuPaint"/>
	</Pool>

	<Pool Name="Gradients" Capacity="32" Ordered="false" Growth="Additive" GrowthValue="32">
		<Component Type="GpuGradient"/>
	</Pool>

	<Pool Name="Effects" Capacity="32" Ordered="false" Growth="Additive" GrowthValue="32">
		<Component Type="GpuEffect"/>
	</Pool>

	<Pool Name="Animations" Capacity="256" Ordered="false" Growth="Additive" GrowthValue="256">
		<Component Type="AnimationTrack"/>
	</Pool>

	<Pool Name="Signals" Capacity="64" Ordered="false" Growth="Additive" GrowthValue="64">
		<Component Type="SignalValue"/>
	</Pool>

	<Pool Name="Keyframes" Capacity="256" Ordered="false" Growth="Additive" GrowthValue="256">
		<Component Type="Keyframe"/>
	</Pool>

</EnginePools>