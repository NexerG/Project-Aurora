<?xml version="1.0" encoding="utf-8" ?>
<ContextMenus xmlns="http://arctisaurora/AuroraUITypes"
			  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:schemaLocation="http://arctisaurora/AuroraUITypes ../Schemas/UITypeSchema.xsd" >

	<ContextMenu Name="view">
		<MenuItem Caption="Split right" Action="View.SplitRight"/>
		<MenuItem Caption="Split down" Action="View.SplitDown"/>
	</ContextMenu>

	<ContextMenu Name="tab">
		<MenuItem Caption="Close" Action="Tab.Close"/>
		<MenuItem Caption="Close others" Action="Tab.CloseOthers" EnabledWhen="Tab.HasSiblings"/>
		<MenuItem Caption="Close to the right" Action="Tab.CloseRight" EnabledWhen="Tab.HasRight"/>
		<MenuItem Caption="Split right" Action="Tab.SplitRight" EnabledWhen="Tab.HasSiblings"/>
		<MenuItem Caption="Split down" Action="Tab.SplitDown" EnabledWhen="Tab.HasSiblings"/>
		<MenuItem Caption="Move to new window" Action="Tab.MoveToNewWindow" EnabledWhen="Tab.CanTearOff"/>
	</ContextMenu>

	<ContextMenu Name="window">
		<MenuItem Caption="Minimize" Action="Window.Minimize"/>
		<MenuItem Caption="Maximize" Action="Window.MaximizeRestore"/>
		<MenuItem Caption="Close" Action="Window.Close"/>
	</ContextMenu>

</ContextMenus>
