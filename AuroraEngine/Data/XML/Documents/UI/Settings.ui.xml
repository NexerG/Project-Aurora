<?xml version="1.0" encoding="utf-8"?>
<NextWindow Width="720" Height="480" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#252525">

	<NextWindowFrame ColorHex="#252525">
	<NextStackPanel Orientation="Vertical" ColorHex="#252525">

		<NextTitleBar Orientation="Horizontal" Height="32" ColorHex="#141414">
			<NextLabel Text="Settings" FontSize="14" Width="120" Height="32" ColorHex="#9D9D9D"/>
			<NextPanel WidthStar="1" Height="32" ColorHex="#141414"/>
			<NextButton Width="46" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A" onRelease="Window.Minimize">
				<NextIcon Set="default" Icon="minimize" Width="14" Height="14" ColorHex="#CCCCCC"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#141414" HoverColorHex="#2A2A2A" PressColorHex="#3A3A3A" onRelease="Window.MaximizeRestore">
				<NextIcon Set="default" Icon="maximize" Width="18" Height="18" ColorHex="#CCCCCC"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#141414" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<NextIcon Set="default" Icon="close" Width="14" Height="14" ColorHex="#CCCCCC"/>
			</NextButton>
		</NextTitleBar>

		<NextStackPanel Orientation="Horizontal" HeightStar="1" ColorHex="#252525">

			<NextStackPanel Name="Categories" Orientation="Vertical" Width="160" ColorHex="#1E1E1E" Padding="8" Spacing="4"/>

			<NextStackPanel Orientation="Vertical" WidthStar="1" ColorHex="#252525" Padding="12" Spacing="8">
				<NextScrollable HeightStar="1" ColorHex="#252525">
					<NextStackPanel Name="Rows" Orientation="Vertical" Spacing="6" ColorHex="#252525"/>
				</NextScrollable>

				<NextStackPanel Orientation="Horizontal" Height="30" ColorHex="#252525">
					<NextPanel WidthStar="1" Height="30" ColorHex="#252525"/>
					<NextButton Width="90" Height="30" ColorHex="#3A3A3A" HoverColorHex="#4A4A4A" PressColorHex="#2A2A2A"
								CornerRadius="4" onRelease="Settings.Save">
						<NextLabel Text="Save" FontSize="14" ColorHex="#CCCCCC"/>
					</NextButton>
				</NextStackPanel>
			</NextStackPanel>

		</NextStackPanel>
	</NextStackPanel>
	</NextWindowFrame>
</NextWindow>
