<?xml version="1.0" encoding="utf-8" ?>
<TestSuite xmlns="http://arctisaurora/AuroraTestTypes"
		  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		  xsi:schemaLocation="http://arctisaurora/AuroraTestTypes ../../Schemas/TestTypeSchema.xsd" >
	<Test Action="Arx.XmlRoundTrip" Timeout="60000"/>
	<Test Action="Arx.BlobRoundTrip"/>
	<Test Action="Arx.MountResolves"/>
	<Test Action="Arx.TamperedEntryRefused"/>
	<Test Action="Arx.TamperedTocRefused"/>
	<Test Action="Arx.WrongKeyRefused"/>
</TestSuite>
