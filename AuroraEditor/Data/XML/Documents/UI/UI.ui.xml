<Window xmlns="http://arctisaurora/AuroraUITypes"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://arctisaurora/UI ../../Schemas/UITypeSchema.xsd"
        Width="1280" Height="720" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#1f6331">

	<StackPanel ColorHex="#121212" Orientation="Vertical">
		<Button Width="150" Height="30" ColorHex="#3A3A3A" HoverColorHex="#4A4A4A" PressColorHex="#2A2A2A"
				CornerRadius="4" onRelease="Settings.Open">
			<Label Text="Settings" FontSize="14" ColorHex="#CCCCCC"/>
		</Button>
		<Button Width="150" Height="30" ColorHex="#3A3A3A" HoverColorHex="#4A4A4A" PressColorHex="#2A2A2A"
				CornerRadius="4" onRelease="UI.ShowAlt">
			<Label Text="Alternate layout" FontSize="14" ColorHex="#CCCCCC"/>
		</Button>
		<Button ControlColor="red" Width="150" Height="150"/>
		<Button ControlColor="green"/>
		<Button ControlColor="green"/>
		<Button ControlColor="green"/>
		<Button ControlColor="blue"/>
		<Button ControlColor="black"/>
		<Button ControlColor="yellow"/>
		<Button ControlColor="cyan" Height="150"/>
		<Button ControlColor="orange" Height="50"/>
	</StackPanel>

</Window>