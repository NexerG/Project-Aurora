  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuroraEngine\AuroraEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Editor\CustomControls\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\XML\Schemas\actionSchema.xsd">
      <SubType>Designer</SubType>
    </None>
    <None Update="Data\XML\Schemas\AllTypesSchema.xsd">
      <SubType>Designer</SubType>
    </None>
    <None Update="Data\XML\Schemas\InputTypeSchema.xsd">
      <SubType>Designer</SubType>
    </None>
    <None Update="Data\XML\Schemas\UITypeSchema.xsd">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

</Project>
