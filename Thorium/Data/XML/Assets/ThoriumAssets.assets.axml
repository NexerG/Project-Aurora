<AssetManifest xmlns="http://arctisaurora/AuroraAssetRegistryTypes"
			   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="http://arctisaurora/AuroraAssetRegistryTypes ../Schemas/AssetRegistryTypeSchema.xsd">

	<Asset Type="UIDocumentAsset" Name="tab-window" Source="XML/Documents/UI/TabWindow.ui.axml"/>
	<Asset Type="UIDocumentAsset" Name="sticky-window" Source="XML/Documents/UI/StickyWindow.ui.axml"/>
	<Asset Type="UIDocumentAsset" Name="settings"   Source="XML/Documents/UI/Settings.ui.axml"/>
	<Asset Type="UIDocumentAsset" Name="vaults"     Source="XML/Documents/UI/Vaults.ui.axml"/>

	<!-- the shell on the new stack -->
	<Asset Type="UIDocumentAsset" Name="main"      Source="XML/Documents/UI/UI.ui.axml"/>
	<Asset Type="UIDocumentAsset" Name="workspace" Source="XML/Documents/UI/Workspace.ui.axml"/>
	<Asset Type="UIDocumentAsset" Name="tab-pane"  Source="XML/Documents/UI/TabPane.ui.axml"/>
	<Asset Type="UIDocumentAsset" Name="sticky-pane" Source="XML/Documents/UI/StickyPane.ui.axml"/>

	<!-- context menus on the new stack, named by a control's ContextMenu attribute -->
	<Asset Type="ContextMenuAsset" Name="title-bar" Source="XML/Documents/Menus/TitleBar.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="workspace" Source="XML/Documents/Menus/Workspace.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="workspace-add" Source="XML/Documents/Menus/WorkspaceAdd.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="pane-new" Source="XML/Documents/Menus/PaneNew.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="thorium"   Source="XML/Documents/Menus/Thorium.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="file"      Source="XML/Documents/Menus/File.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="edit"      Source="XML/Documents/Menus/Edit.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="note"      Source="XML/Documents/Menus/Note.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="sheet"     Source="XML/Documents/Menus/Sheet.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="planner"   Source="XML/Documents/Menus/Planner.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="planner-category" Source="XML/Documents/Menus/PlannerCategory.menu.axml"/>

	<Asset Type="ContextMenuAsset" Name="vault"        Source="XML/Documents/Menus/Vault.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-folder" Source="XML/Documents/Menus/VaultFolder.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-note"   Source="XML/Documents/Menus/VaultNote.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-csv"    Source="XML/Documents/Menus/VaultCsv.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-note-xml"   Source="XML/Documents/Menus/VaultNoteXml.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-as-note"    Source="XML/Documents/Menus/VaultAsNote.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-as-sheet"   Source="XML/Documents/Menus/VaultAsSheet.menu.axml"/>
	<Asset Type="ContextMenuAsset" Name="vault-as-planner" Source="XML/Documents/Menus/VaultAsPlanner.menu.axml"/>

	<!-- Latin Modern, baked from _Build/FontSources -->
	<Asset Type="FontAsset" Name="latin-modern"      Source="Fonts/lmroman10-regular"/>
	<Asset Type="FontAsset" Name="latin-modern-mono" Source="Fonts/lmmono10-regular"/>
	<Asset Type="FontAsset" Name="latin-modern-math" Source="Fonts/latinmodern-math"/>
	<!-- TeX Gyre Termes, the Times of mathptmx and kin, baked from _Build/FontSources -->
	<Asset Type="FontAsset" Name="tex-gyre-termes"   Source="Fonts/texgyretermes-regular"/>

</AssetManifest>
