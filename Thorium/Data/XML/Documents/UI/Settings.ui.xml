<?xml version="1.0" encoding="utf-8"?>
<NextWindow Width="720" Height="480" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#F0EFEA">

	<NextWindowFrame ColorHex="#F0EFEA">
	<NextStackPanel Orientation="Vertical" ColorHex="#F0EFEA">

		<NextTitleBar Orientation="Horizontal" Height="32" ColorHex="#EBEAE5">
			<NextLabel Text="Settings" FontSize="14" Width="120" Height="32" ColorHex="#5F5D56"/>
			<NextPanel WidthStar="1" Height="32" ColorHex="#EBEAE5"/>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.Minimize">
				<NextIcon Set="default" Icon="minimize" Width="14" Height="14" ColorHex="#5F5D56"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.MaximizeRestore">
				<NextIcon Set="default" Icon="maximize" Width="18" Height="18" ColorHex="#5F5D56"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<NextIcon Set="default" Icon="close" Width="14" Height="14" ColorHex="#5F5D56"/>
			</NextButton>
		</NextTitleBar>

		<NextStackPanel Orientation="Horizontal" HeightStar="1" ColorHex="#F0EFEA">

			<NextStackPanel Name="Categories" Orientation="Vertical" Width="160" ColorHex="#F2F1ED" Padding="8" Spacing="4"/>

			<NextStackPanel Orientation="Vertical" WidthStar="1" ColorHex="#F0EFEA" Padding="12" Spacing="8">
				<NextScrollable HeightStar="1" ColorHex="#F0EFEA"
								ThumbColorHex="#D7D5CD" ThumbHoverColorHex="#C9C6BC" ThumbPressColorHex="#BAB7AC">
					<NextStackPanel Name="Rows" Orientation="Vertical" Spacing="6" ColorHex="#F0EFEA"/>
				</NextScrollable>

				<NextStackPanel Orientation="Horizontal" Height="30" ColorHex="#F0EFEA">
					<NextPanel WidthStar="1" Height="30" ColorHex="#F0EFEA"/>
					<NextButton Width="90" Height="30" ColorHex="#E3E1D9" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"
								CornerRadius="4" onRelease="Settings.Save">
						<NextLabel Text="Save" FontSize="14" ColorHex="#5F5D56"/>
					</NextButton>
				</NextStackPanel>
			</NextStackPanel>

		</NextStackPanel>
	</NextStackPanel>
	</NextWindowFrame>
</NextWindow>
