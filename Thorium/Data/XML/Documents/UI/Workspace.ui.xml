<?xml version="1.0" encoding="utf-8"?>
<!-- The workspace's authored arrangement, mirroring Workspace.ui.xml. -->
<SplitView Orientation="Horizontal" HeightStar="1">

	<EditableTabs Name="Tabs" Width="525" MinWidth="120" ContextMenu="view"
	                  TabHeight="28" TabWidth="180"
	                  TearOffDocument="tab-window">
		<TabItem Header="SampleNote">
			<DocumentEditor Source="../../Notes/SampleNote.xml"/>
		</TabItem>
	</EditableTabs>
	<Splitter Width="5"/>
	<EditableTabs Name="TabsRight" WidthStar="1" MinWidth="120" ContextMenu="view"
	                  TabHeight="28" TabWidth="180"
	                  TearOffDocument="tab-window">
		<TabItem Header="Keybinds">
			<DocumentEditor Source="../../Notes/Reference/Keybinds.xml"/>
		</TabItem>
	</EditableTabs>
</SplitView>
