<?xml version="1.0" encoding="utf-8"?>
<WindowRoot Width="520" Height="400" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical">

	<WindowFrame Role="Surface">
	<StackPanel Orientation="Vertical">

		<TitleBar Orientation="Horizontal" Height="32">
			<Label Text="Vaults" FontSize="14" Width="120" Height="32" Role="MutedInk" Effect="title-in"/>
			<Panel WidthStar="1" Height="32"/>
			<Button Width="46" Height="32" onRelease="Window.Minimize">
				<Icon Set="default" Icon="minimize" Width="14" Height="14"/>
			</Button>
			<Button Width="46" Height="32" onRelease="Window.MaximizeRestore">
				<Icon Set="default" Icon="maximize" Width="18" Height="18"/>
			</Button>
			<Button Width="46" Height="32" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Icon Set="default" Icon="close" Width="14" Height="14"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Vertical" HeightStar="1" Padding="12" Spacing="8">
			<Scrollable HeightStar="1">
				<StackPanel Name="Rows" Orientation="Vertical" Spacing="6"/>
			</Scrollable>

			<StackPanel Orientation="Horizontal" Height="30">
				<Panel WidthStar="1" Height="30"/>
				<Button Width="110" Height="30" Role="Chrome" CornerRadius="4" StateBinding="chrome-press" EdgeRole="Accent" onRelease="Vaults.Add">
					<Label Text="Add vault…" FontSize="14" Role="MutedInk"/>
				</Button>
			</StackPanel>
		</StackPanel>

	</StackPanel>
	</WindowFrame>
</WindowRoot>
