<?xml version="1.0" encoding="utf-8"?>
<!-- Thorium's shell on the new stack, mirroring UI.ui.xml. Stubs stand in for the controls that
     have not been ported: the document toolbar is a bare band. -->
<WindowRoot Width="1280" Height="720" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical">

	<WindowFrame>
	<StackPanel Orientation="Vertical">

		<TitleBar Orientation="Horizontal" Height="32" Gradient="titlebar" ContextMenu="title-bar" StopsContextMenu="true">
			<Panel Width="3" Height="14" Margin="0,0,0,12" VerticalAlignment="Center" Role="Accent"/>
			<MenuButton Width="72" Height="32" ContextMenu="thorium">
				<Label Text="Thorium" FontSize="13" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<MenuButton Width="48" Height="32" ContextMenu="file">
				<Label Text="File" FontSize="13" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<MenuButton Width="48" Height="32" ContextMenu="edit">
				<Label Text="Edit" FontSize="13" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<MenuButton Width="48" Height="32" ContextMenu="view">
				<Label Text="View" FontSize="13" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<Panel WidthStar="1" Height="32"/>
			<Button Width="46" Height="32" onRelease="Window.Minimize">
				<Icon Set="default" Icon="minimize" Width="14" Height="14" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
			<Button Width="46" Height="32" onRelease="Window.MaximizeRestore">
				<Icon Set="default" Icon="maximize" Width="18" Height="18" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
			<Button Width="46" Height="32" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Icon Set="default" Icon="close" Width="14" Height="14" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Horizontal" HeightStar="1">
			<StackPanel Orientation="Vertical" Width="220" MinWidth="120" Role="Surface">
				<VaultBrowser Name="Browser" HeightStar="1" Padding="8"/>
			</StackPanel>
			<Splitter Width="5"/>
			<StackPanel Orientation="Vertical" WidthStar="1">
				<DocumentToolbar Height="30" HorizontalAlignment="Stretch"/>
				<Workspace Name="Workspace" HeightStar="1" Default="workspace" Pane="tab-pane"/>
			</StackPanel>
		</StackPanel>
	</StackPanel>
	</WindowFrame>
</WindowRoot>
