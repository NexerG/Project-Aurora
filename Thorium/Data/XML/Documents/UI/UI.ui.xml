<?xml version="1.0" encoding="utf-8"?>
<!-- Thorium's shell on the new stack, mirroring UI.ui.xml. Stubs stand in for the controls that
     have not been ported: the document toolbar is a bare band. -->
<WindowRoot Width="1280" Height="720" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical">

	<WindowFrame>
	<StackPanel Orientation="Vertical">

		<TitleBar Orientation="Horizontal" Height="26" Gradient="titlebar" EdgeThickness="0,0,1,0" EdgeRole="Line" ContextMenu="title-bar" StopsContextMenu="true">
			<Panel Width="3" Height="14" Margin="0,0,0,12" VerticalAlignment="Center" Role="Accent" Clip="accent-grow"/>
			<MenuButton Width="72" Height="26" ContextMenu="thorium" HoverClip="underline" EdgeRole="Accent">
				<Label Text="Thorium" FontSize="12" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk" Effect="title-in"/>
			</MenuButton>
			<MenuButton Width="48" Height="26" ContextMenu="file" HoverClip="underline" EdgeRole="Accent">
				<Label Text="File" FontSize="12" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<MenuButton Width="48" Height="26" ContextMenu="edit" HoverClip="underline" EdgeRole="Accent">
				<Label Text="Edit" FontSize="12" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<MenuButton Width="48" Height="26" ContextMenu="view" HoverClip="underline" EdgeRole="Accent">
				<Label Text="View" FontSize="12" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<Panel Width="1" Height="14" Margin="0,8,0,8" VerticalAlignment="Center" Role="Line"/>
			<WorkspaceBar Height="26" TearOffDocument="tab-window"/>
			<MenuButton Width="22" Height="22" Margin="2,0,0,2" ContextMenu="workspace-add" HoverClip="underline" EdgeRole="Accent">
				<Label Text="+" FontSize="14" HorizontalPos="0.5" VerticalPos="0.5" Role="MutedInk"/>
			</MenuButton>
			<Panel WidthStar="1" Height="26"/>
			<Button Width="40" Height="26" onRelease="Window.MinimizeToTray">
				<Icon Set="default" Icon="tray" Width="14" Height="14" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
			<Button Width="40" Height="26" onRelease="Window.Minimize">
				<Icon Set="default" Icon="minimize" Width="12" Height="12" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
			<Button Width="40" Height="26" onRelease="Window.MaximizeRestore">
				<Icon Set="default" Icon="maximize" Width="14" Height="14" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
			<Button Width="40" Height="26" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Icon Set="default" Icon="close" Width="12" Height="12" HorizontalPos="0.5" VerticalPos="0.5"/>
			</Button>
		</TitleBar>

		<Ribbon Height="30" ConvertCsv="Sheets.ConvertOpenCsv"/>

		<StackPanel Orientation="Horizontal" HeightStar="1">
			<StackPanel Orientation="Vertical" Width="200" MinWidth="120" Role="Surface">
				<StackPanel Orientation="Horizontal" Height="24" Padding="0,10,0,10" EdgeThickness="0,0,1,0" EdgeRole="Line">
					<Label Name="VaultFilter" Text="All files" FontSize="12" Height="24" VerticalPos="0.5" Role="MutedInk"/>
				</StackPanel>
				<VaultBrowser Name="Browser" HeightStar="1" Padding="8,0,8,0"/>
			</StackPanel>
			<Splitter Width="3"/>
			<StackPanel Orientation="Vertical" WidthStar="1">
				<Workspace Name="Workspace" HeightStar="1" Default="workspace" Pane="tab-pane" FirstRun="General Docs Sheets LaTeX Manager Calendar"/>
			</StackPanel>
			<Splitter Width="3"/>
			<Inspector Width="240"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Height="22" Padding="0,4,0,4" Role="Surface" EdgeThickness="1,0,0,0" EdgeRole="Line">
			<Button Width="136" Height="22" onRelease="Status.CycleStore">
				<StackPanel Orientation="Horizontal" Height="22" Padding="0,8,0,8">
					<Icon Name="StatusStoreIcon" Set="default" Icon="cloud" Width="12" Height="12" Margin="0,6,0,0" VerticalAlignment="Center"/>
					<Label Name="StatusStore" Text="Online server" FontSize="11" WidthStar="1" Height="22" VerticalPos="0.5" Role="MutedInk"/>
					<Icon Set="default" Icon="chevron-up" Width="10" Height="10" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<StackPanel Name="StatusConnection" Orientation="Horizontal" Width="98" Height="22">
				<Panel Width="1" Height="12" Margin="0,5,0,5" VerticalAlignment="Center" Role="Line"/>
				<Button Width="96" Height="22" onRelease="Status.ToggleConnection">
					<StackPanel Orientation="Horizontal" Height="22" Padding="0,8,0,8">
						<Panel Name="StatusConnectionDot" Width="7" Height="7" CornerRadius="3.5" ColorHex="#3C7A3A" Margin="0,6,0,0" VerticalAlignment="Center"/>
						<Label Text="Connection" FontSize="11" WidthStar="1" Height="22" VerticalPos="0.5" Role="MutedInk"/>
					</StackPanel>
				</Button>
			</StackPanel>
			<Panel Width="1" Height="12" Margin="0,5,0,5" VerticalAlignment="Center" Role="Line"/>
			<Button Width="142" Height="22" onRelease="Status.TogglePending">
				<StackPanel Orientation="Horizontal" Height="22" Padding="0,8,0,8">
					<Icon Set="default" Icon="git-branch" Width="12" Height="12" Margin="0,6,0,0" VerticalAlignment="Center"/>
					<Panel Name="StatusGitDot" Width="7" Height="7" CornerRadius="3.5" ColorHex="#D9A21B" Margin="0,6,0,0" VerticalAlignment="Center"/>
					<Label Name="StatusGit" Text="Changes pending" FontSize="11" WidthStar="1" Height="22" VerticalPos="0.5" Role="MutedInk"/>
				</StackPanel>
			</Button>
		</StackPanel>
	</StackPanel>
	</WindowFrame>
</WindowRoot>
