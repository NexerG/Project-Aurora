<?xml version="1.0" encoding="utf-8"?>
<NextWindow Width="900" Height="640" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#FBFAF8">

	<NextWindowFrame ColorHex="#FBFAF8">
	<NextStackPanel Orientation="Vertical" ColorHex="#FBFAF8">

		<NextTitleBar Orientation="Horizontal" Height="32" ColorHex="#EBEAE5">
			<NextLabel Text="Thorium" FontSize="14" Width="120" Height="32" ColorHex="#5F5D56"/>
			<NextPanel WidthStar="1" Height="32" ColorHex="#EBEAE5"/>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.Minimize">
				<NextLabel Text="-" FontSize="16" ColorHex="#5F5D56"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.MaximizeRestore">
				<NextLabel Text="[]" FontSize="16" ColorHex="#5F5D56"/>
			</NextButton>
			<NextButton Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<NextLabel Text="X" FontSize="16" ColorHex="#5F5D56"/>
			</NextButton>
		</NextTitleBar>

		<NextDocumentToolbar Height="30" HorizontalAlignment="Stretch" ColorHex="#FBFAF8"
							 HoverColorHex="#F0EFEA" PressColorHex="#EAE8E2"
							 IdleInkColorHex="#6F6D66" ActiveInkColorHex="#3A3833"
							 SeparatorColorHex="#DCDAD3" FieldColorHex="#EAE8E2"/>

		<NextWorkspace Name="Workspace" HeightStar="1" Default="next-tab-pane" Pane="next-tab-pane"/>
	</NextStackPanel>
	</NextWindowFrame>
</NextWindow>
