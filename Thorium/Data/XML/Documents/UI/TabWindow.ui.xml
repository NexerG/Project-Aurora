<?xml version="1.0" encoding="utf-8"?>
<WindowRoot Width="900" Height="640" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical">

	<WindowFrame>
	<StackPanel Orientation="Vertical">

		<TitleBar Orientation="Horizontal" Height="32">
			<Label Text="Thorium" FontSize="14" Width="120" Height="32" Role="MutedInk"/>
			<Panel WidthStar="1" Height="32"/>
			<Button Width="46" Height="32" onRelease="Window.Minimize">
				<Label Text="-" FontSize="16" Role="MutedInk"/>
			</Button>
			<Button Width="46" Height="32" onRelease="Window.MaximizeRestore">
				<Label Text="[]" FontSize="16" Role="MutedInk"/>
			</Button>
			<Button Width="46" Height="32" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Label Text="X" FontSize="16" Role="MutedInk"/>
			</Button>
		</TitleBar>

		<DocumentToolbar Height="30" HorizontalAlignment="Stretch"/>

		<Workspace Name="Workspace" HeightStar="1" Default="tab-pane" Pane="tab-pane"/>
	</StackPanel>
	</WindowFrame>
</WindowRoot>
