<?xml version="1.0" encoding="utf-8"?>
<WindowRoot Width="900" Height="640" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical">

	<WindowFrame>
	<StackPanel Orientation="Vertical">

		<TitleBar Orientation="Horizontal" Height="26">
			<Panel Width="3" Height="14" Margin="0,8,0,12" VerticalAlignment="Center" Role="Accent" Clip="accent-grow"/>
			<Label Text="Thorium" FontSize="12" Width="120" Height="26" Role="MutedInk" Effect="title-in"/>
			<Panel WidthStar="1" Height="26"/>
			<Button Width="40" Height="26" onRelease="Window.Minimize">
				<Label Text="-" FontSize="16" Role="MutedInk"/>
			</Button>
			<Button Width="40" Height="26" onRelease="Window.MaximizeRestore">
				<Label Text="[]" FontSize="16" Role="MutedInk"/>
			</Button>
			<Button Width="40" Height="26" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Label Text="X" FontSize="16" Role="MutedInk"/>
			</Button>
		</TitleBar>

		<Workspace Name="Workspace" HeightStar="1" Default="tab-pane" Pane="tab-pane"/>
	</StackPanel>
	</WindowFrame>
</WindowRoot>
