<?xml version="1.0" encoding="utf-8"?>
<!-- The workspace's authored arrangement, mirroring Workspace.ui.xml. Panels stand in for the
     document editors, which are 6c. -->
<NextSplitView Orientation="Horizontal" HeightStar="1">

	<NextEditableTabs Name="Tabs" Width="525" MinWidth="120" ColorHex="#FBFAF8"
	                  TabHeight="28" TabWidth="180"
	                  TabColorHex="#F0EFEA" ActiveTabColorHex="#FBFAF8" TabHoverColorHex="#E8E6E0" TabInkColorHex="#34322D"
	                  GripColorHex="#E6E4DE" GripHoverColorHex="#DCDAD3" GripPressColorHex="#D0CEC6">
		<NextTabItem Header="SampleNote">
			<NextPanel ColorHex="#FBFAF8"/>
		</NextTabItem>
	</NextEditableTabs>
	<NextSplitter Width="5" ColorHex="#E6E4DE" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"/>
	<NextEditableTabs Name="TabsRight" WidthStar="1" MinWidth="120" ColorHex="#FBFAF8"
	                  TabHeight="28" TabWidth="180"
	                  TabColorHex="#F0EFEA" ActiveTabColorHex="#FBFAF8" TabHoverColorHex="#E8E6E0" TabInkColorHex="#34322D"
	                  GripColorHex="#E6E4DE" GripHoverColorHex="#DCDAD3" GripPressColorHex="#D0CEC6">
		<NextTabItem Header="Keybinds">
			<NextPanel ColorHex="#FBFAF8"/>
		</NextTabItem>
	</NextEditableTabs>
</NextSplitView>
