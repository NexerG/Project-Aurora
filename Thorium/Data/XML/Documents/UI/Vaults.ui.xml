<Window xmlns="http://arctisaurora/AuroraUITypes"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://arctisaurora/UI ../../Schemas/UITypeSchema.xsd"
        Width="520" Height="400" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical" ColorHex="#F0EFEA">

	<WindowFrame ColorHex="#F0EFEA">
	<StackPanel Orientation="Vertical" ColorHex="#F0EFEA">

		<TitleBar Orientation="Horizontal" Height="32" ColorHex="#EBEAE5">
			<Label Text="Vaults" FontSize="14" Width="120" Height="32" ColorHex="#5F5D56"/>
			<Panel WidthStar="1" Height="32" ColorHex="#EBEAE5" BubbleClick="true"/>
			<Button Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.Minimize">
				<Icon Set="default" Icon="minimize" Width="14" Height="14" ColorHex="#5F5D56"/>
			</Button>
			<Button Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD" onRelease="Window.MaximizeRestore">
				<Icon Set="default" Icon="maximize" Width="18" Height="18" ColorHex="#5F5D56"/>
			</Button>
			<Button Width="46" Height="32" ColorHex="#EBEAE5" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Icon Set="default" Icon="close" Width="14" Height="14" ColorHex="#5F5D56"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Vertical" HeightStar="1" ColorHex="#F0EFEA" Padding="12" Spacing="8">
			<ScrollableControl HeightStar="1" ColorHex="#F0EFEA"
							   ThumbColorHex="#D7D5CD" ThumbHoverColorHex="#C9C6BC" ThumbPressColorHex="#BAB7AC">
				<StackPanel Name="Rows" Orientation="Vertical" Spacing="6" ColorHex="#F0EFEA"/>
			</ScrollableControl>

			<StackPanel Orientation="Horizontal" Height="30" ColorHex="#F0EFEA">
				<Panel WidthStar="1" Height="30" ColorHex="#F0EFEA"/>
				<Button Width="110" Height="30" ColorHex="#E3E1D9" HoverColorHex="#DCDAD3" PressColorHex="#D0CEC6"
						CornerRadius="4" onRelease="Vaults.Add">
					<Label Text="Add vault…" FontSize="14" ColorHex="#5F5D56"/>
				</Button>
			</StackPanel>
		</StackPanel>

	</StackPanel>
	</WindowFrame>
</Window>
