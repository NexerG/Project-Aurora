<?xml version="1.0" encoding="utf-8"?>
<!-- Landing 6a/6b0/6b1 probe. NextWindow is WindowRoot, NextContainer is ContainerControl.
     Deleted with 6b. -->
<NextWindow Width="1280" Height="720" Padding="0">

	<!-- attributes: colour, corner radii as four values, edge band, padding -->
	<NextContainer Name="card"
	               Width="360" Height="220"
	               Padding="16"
	               HorizontalAlignment="Left" VerticalAlignment="Top"
	               ColorHex="#3AA6FF"
	               CornerRadius="16,4,16,4"
	               EdgeColorHex="#FFFFFF" EdgeThickness="2">
		<NextContainer Name="inner" Padding="12" ColorHex="#12314A" CornerRadius="8"/>
	</NextContainer>

	<!-- ClipToBounds, with a child larger than its parent -->
	<NextContainer Name="clipped"
	               Width="200" Height="140"
	               HorizontalAlignment="Right" VerticalAlignment="Top"
	               ClipToBounds="true"
	               ColorHex="#2A2F3A" CornerRadius="8">
		<NextContainer Name="overflow" Width="320" Height="260" ColorHex="#EF476F"/>
	</NextContainer>

	<!-- the ControlColor enum and a two-value corner radius -->
	<NextContainer Name="swatch"
	               Width="220" Height="90"
	               HorizontalAlignment="Right" VerticalAlignment="Bottom"
	               Margin="0,0,56,0"
	               ControlColor="teal" CornerRadius="10,0"/>

	<!-- Stretch alignment and a bottom anchor -->
	<NextContainer Name="bar"
	               Height="48"
	               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
	               ColorHex="#06D6A0" CornerRadius="6"/>

	<!-- the gradient table, ramped across the control's own rect -->
	<NextContainer Name="ramp"
	               Width="240" Height="120"
	               HorizontalAlignment="Center" VerticalAlignment="Center"
	               CornerRadius="12"
	               Gradient="accent"/>

	<!-- 6b1: the shell's title bar, minus the caption drag and the resize grips -->
	<NextStackPanel Name="titlebar"
	                Orientation="Horizontal" Height="32"
	                HorizontalAlignment="Stretch" VerticalAlignment="Top"
	                ColorHex="#EBEAE5" Gradient="titlebar">
		<NextButton Name="menuThorium" Width="72"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="Thorium" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="menuFile" Width="48"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="File" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="menuEdit" Width="48"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="Edit" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="menuView" Width="48"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="View" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>

		<NextPanel Name="spacer" WidthStar="1" ColorHex="#EBEAE5"/>

		<NextButton Name="min" Width="46"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD"
		            onRelease="Window.Minimize">
			<NextIcon Set="default" Icon="minimize" Width="14" Height="14"
			          HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="max" Width="46"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD"
		            onRelease="Window.MaximizeRestore">
			<NextIcon Set="default" Icon="maximize" Width="18" Height="18"
			          HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="close" Width="46"
		            ColorHex="#EBEAE5" HoverColorHex="#C42B1E" PressColorHex="#A82318"
		            onRelease="Window.Close">
			<NextIcon Set="default" Icon="close" Width="14" Height="14"
			          HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
	</NextStackPanel>

</NextWindow>
