<?xml version="1.0" encoding="utf-8"?>
<!-- Landing 6a/6b0/6b1 probe. NextWindow is WindowRoot, NextContainer is ContainerControl.
     Deleted with 6b. -->
<NextWindow Width="1280" Height="720" Padding="0">

<!-- the resize grips, and the box everything else is arranged in -->
<NextWindowFrame Name="frame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

	<!-- attributes: colour, corner radii as four values, edge band, padding -->
	<NextContainer Name="card"
	               Width="360" Height="220"
	               Padding="16"
	               HorizontalAlignment="Left" VerticalAlignment="Top"
	               ColorHex="#3AA6FF"
	               CornerRadius="16,4,16,4"
	               EdgeColorHex="#FFFFFF" EdgeThickness="2">
		<NextContainer Name="inner" Padding="12" ColorHex="#12314A" CornerRadius="8"/>
	</NextContainer>

	<!-- ClipToBounds, with a child larger than its parent -->
	<NextContainer Name="clipped"
	               Width="200" Height="140"
	               HorizontalAlignment="Right" VerticalAlignment="Top"
	               ClipToBounds="true"
	               ColorHex="#2A2F3A" CornerRadius="8">
		<NextContainer Name="overflow" Width="320" Height="260" ColorHex="#EF476F"/>
	</NextContainer>

	<!-- the ControlColor enum and a two-value corner radius -->
	<NextContainer Name="swatch"
	               Width="220" Height="90"
	               HorizontalAlignment="Right" VerticalAlignment="Bottom"
	               Margin="0,0,56,0"
	               ControlColor="teal" CornerRadius="10,0"/>

	<!-- Stretch alignment and a bottom anchor -->
	<NextContainer Name="bar"
	               Height="48"
	               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
	               ColorHex="#06D6A0" CornerRadius="6"/>

	<!-- 6b tier 1: a sized pane against a star one, and a star pair inside it -->
	<NextSplitView Name="split"
	               Orientation="Horizontal"
	               Width="420" Height="200"
	               HorizontalAlignment="Left" VerticalAlignment="Center">
		<NextPanel Name="paneA" Width="160" ColorHex="#2A2F3A" CornerRadius="6"/>
		<NextSplitter Name="gripH" Width="5"/>
		<NextSplitView Name="splitV" Orientation="Vertical" WidthStar="1">
			<NextPanel Name="paneB" HeightStar="1" ColorHex="#12314A" CornerRadius="6"/>
			<NextSplitter Name="gripV" Height="5"/>
			<NextPanel Name="paneC" HeightStar="1" ColorHex="#EF476F" CornerRadius="6"/>
		</NextSplitView>
	</NextSplitView>

	<!-- 6b tier 1: content overflowing on both axes, so both thumbs show -->
	<NextScrollable Name="scroller"
	                Width="260" Height="200"
	                HorizontalAlignment="Right" VerticalAlignment="Center"
	                ScrollDirection="Both"
	                ColorHex="#1A1D24" CornerRadius="6">
		<!-- alternating row widths, so a horizontal shift is visible at all -->
		<NextStackPanel Name="scrollBody" Orientation="Vertical" Width="420" Spacing="6">
			<NextPanel Width="420" Height="40" ColorHex="#3AA6FF"/>
			<NextPanel Width="140" Height="40" ColorHex="#06D6A0"/>
			<NextPanel Width="420" Height="40" ColorHex="#FFD166"/>
			<NextPanel Width="140" Height="40" ColorHex="#EF476F"/>
			<NextPanel Width="420" Height="40" ColorHex="#8338EC"/>
			<NextPanel Width="140" Height="40" ColorHex="#3AA6FF"/>
			<NextPanel Width="420" Height="40" ColorHex="#06D6A0"/>
			<NextPanel Width="140" Height="40" ColorHex="#FFD166"/>
		</NextStackPanel>
	</NextScrollable>

	<!-- the gradient table, ramped across the control's own rect -->
	<NextContainer Name="ramp"
	               Width="240" Height="120"
	               HorizontalAlignment="Center" VerticalAlignment="Center"
	               CornerRadius="12"
	               Gradient="accent"/>

	<!-- 6b1: the shell's title bar -->
	<NextTitleBar Name="titlebar"
	                Orientation="Horizontal" Height="32"
	                HorizontalAlignment="Stretch" VerticalAlignment="Top"
	                ColorHex="#EBEAE5" Gradient="titlebar">
		<NextButton Name="menuThorium" Width="72"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="Thorium" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="menuFile" Width="48"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="File" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="menuEdit" Width="48"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="Edit" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="menuView" Width="48"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD">
			<NextLabel Text="View" FontSize="13"
			           HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>

		<NextPanel Name="spacer" WidthStar="1" ColorHex="#EBEAE5"/>

		<NextButton Name="min" Width="46"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD"
		            onRelease="Window.Minimize">
			<NextIcon Set="default" Icon="minimize" Width="14" Height="14"
			          HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="max" Width="46"
		            ColorHex="#EBEAE5" HoverColorHex="#E3E1D9" PressColorHex="#D7D5CD"
		            onRelease="Window.MaximizeRestore">
			<NextIcon Set="default" Icon="maximize" Width="18" Height="18"
			          HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
		<NextButton Name="close" Width="46"
		            ColorHex="#EBEAE5" HoverColorHex="#C42B1E" PressColorHex="#A82318"
		            onRelease="Window.Close">
			<NextIcon Set="default" Icon="close" Width="14" Height="14"
			          HorizontalPos="0.5" VerticalPos="0.5" ColorHex="#5F5D56"/>
		</NextButton>
	</NextTitleBar>

	<!-- 6b tier 2: two tab views either side of a grip, for the drag between them -->
	<NextSplitView Name="tabsplit"
	               Orientation="Horizontal"
	               Width="520" Height="240"
	               HorizontalAlignment="Left" VerticalAlignment="Bottom">
		<NextTabView Name="tabsLeft" Width="250">
			<NextTabItem Header="alpha">
				<NextPanel ColorHex="#12314A"/>
			</NextTabItem>
			<NextTabItem Header="beta">
				<NextPanel ColorHex="#3AA6FF"/>
			</NextTabItem>
		</NextTabView>
		<NextSplitter Name="tabGrip" Width="5"/>
		<NextTabView Name="tabsRight" WidthStar="1">
			<NextTabItem Header="gamma">
				<NextPanel ColorHex="#EF476F"/>
			</NextTabItem>
		</NextTabView>
	</NextSplitView>

	<!-- 6b tier 3: containers and file browsing. Padded clear of the title bar. -->
	<NextPanel Name="probe3"
	           Width="780" Height="330"
	           HorizontalAlignment="Center" VerticalAlignment="Top"
	           Padding="40,0,0,0" Alpha="0">
		<NextStackPanel Name="probe3Row" Orientation="Horizontal" Spacing="8" Alpha="0">

			<!-- dock bands in declaration order, the last child filling what is left -->
			<NextDock Name="dock" Width="300" Height="280" Padding="4"
			          ColorHex="#1A1D24" CornerRadius="6">
				<NextPanel Name="dockTop" DockMode="Top" Height="24" ColorHex="#FFD166"/>
				<NextPanel Name="dockLeft" DockMode="Left" Width="48" ColorHex="#8338EC"/>
				<NextVaultBrowser Name="vault"
				                  RowHeight="20" RowFontSize="13" Indent="10"
				                  ColorHex="#171717"/>
			</NextDock>

			<!-- a Fixed band, a Star band, and two Star columns weighted 1 and 2 -->
			<NextGridList Name="grid" Width="280" Height="280" Padding="4"
			              ColorHex="#1A1D24" CornerRadius="6">
				<NextRowDefinition SizeMode="Fixed" Height="60"/>
				<NextRowDefinition SizeMode="Star" Height="1"/>
				<NextColumnDefinition SizeMode="Star" Width="1"/>
				<NextColumnDefinition SizeMode="Star" Width="2"/>
				<NextPanel Grid.Row="0" Grid.Column="0" ColorHex="#3AA6FF"/>
				<NextPanel Grid.Row="0" Grid.Column="1" ColorHex="#06D6A0"/>
				<NextPanel Grid.Row="1" Grid.Column="0" ColorHex="#EF476F"/>
				<NextPanel Grid.Row="1" Grid.Column="1" ColorHex="#FFD166"/>
			</NextGridList>

			<!-- a transparent workspace holding one authored pane, and renameable tab captions -->
			<NextWorkspace Name="workspace" Width="176" Height="280">
				<NextEditableTabs Name="renameTabs">
					<NextTabItem Header="one">
						<NextPanel ColorHex="#12314A"/>
					</NextTabItem>
					<NextTabItem Header="two">
						<NextPanel ColorHex="#2A2F3A"/>
					</NextTabItem>
				</NextEditableTabs>
			</NextWorkspace>

		</NextStackPanel>
	</NextPanel>

	<!-- 6b tier 1: content that fits, so neither thumb may draw -->
	<NextScrollable Name="fits"
	                Width="200" Height="120"
	                HorizontalAlignment="Center" VerticalAlignment="Bottom"
	                ScrollDirection="Both"
	                ColorHex="#1A1D24" CornerRadius="6">
		<NextPanel Name="fitsBody" Width="120" Height="60" ColorHex="#06D6A0"/>
	</NextScrollable>

</NextWindowFrame>

</NextWindow>
