<?xml version="1.0" encoding="utf-8"?>
<WindowRoot Width="720" Height="480" WindowingMode="WindowSize" Autoscaling="false" ScalingAxis="Vertical">

	<WindowFrame Role="Surface">
	<StackPanel Orientation="Vertical">

		<TitleBar Orientation="Horizontal" Height="32">
			<Label Text="Settings" FontSize="14" Width="120" Height="32" Role="MutedInk" Effect="title-in"/>
			<Panel WidthStar="1" Height="32"/>
			<Button Width="46" Height="32" onRelease="Window.Minimize">
				<Icon Set="default" Icon="minimize" Width="14" Height="14"/>
			</Button>
			<Button Width="46" Height="32" onRelease="Window.MaximizeRestore">
				<Icon Set="default" Icon="maximize" Width="18" Height="18"/>
			</Button>
			<Button Width="46" Height="32" HoverColorHex="#C42B1E" PressColorHex="#A82318" onRelease="Window.Close">
				<Icon Set="default" Icon="close" Width="14" Height="14"/>
			</Button>
		</TitleBar>

		<StackPanel Orientation="Horizontal" HeightStar="1">

			<StackPanel Name="Categories" Orientation="Vertical" Width="160" Role="Surface" Padding="8" Spacing="4"/>

			<StackPanel Orientation="Vertical" WidthStar="1" Padding="12" Spacing="8">
				<Scrollable HeightStar="1">
					<StackPanel Name="Rows" Orientation="Vertical" Spacing="6"/>
				</Scrollable>

				<StackPanel Orientation="Horizontal" Height="30" Spacing="8">
					<Panel WidthStar="1" Height="30"/>
					<Button Width="90" Height="30" Role="Chrome"
								CornerRadius="4" StateBinding="chrome-press" EdgeRole="Accent" onRelease="Settings.Save">
						<Label Text="Save" FontSize="14" Role="MutedInk"/>
					</Button>
					<Button Name="Apply" Width="90" Height="30" Role="Chrome"
								CornerRadius="4" StateBinding="chrome-press" EdgeRole="Accent" onRelease="Settings.Apply">
						<Label Text="Apply" FontSize="14" Role="MutedInk"/>
					</Button>
				</StackPanel>
			</StackPanel>

		</StackPanel>
	</StackPanel>
	</WindowFrame>
</WindowRoot>
