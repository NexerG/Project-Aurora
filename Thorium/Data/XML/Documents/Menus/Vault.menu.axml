<?xml version="1.0" encoding="utf-8"?>
<ContextMenu>
	<ContextSubmenu Text="New">
		<ContextButton Text="Folder" Action="Folders.New"/>
		<ContextButton Text="Doc" Action="Notes.New"/>
		<ContextSubmenu Text="Sheet">
			<ContextButton Text="Fixed size" Action="Sheets.NewFixed"/>
			<ContextButton Text="Unfixed" Action="Sheets.New"/>
		</ContextSubmenu>
		<ContextButton Text="Planner" Action="Planners.New"/>
	</ContextSubmenu>
	<ContextLine/>
	<ContextButton Text="Lock vault..." Action="Vault.Lock"/>
	<ContextButton Text="Unlock vault..." Action="Vault.Unlock"/>
	<ContextButton Text="Change vault password..." Action="Vault.ChangePassword"/>
	<ContextButton Text="Use Windows Hello for this vault..." Action="Vault.EnableHello"/>
	<ContextButton Text="Remove vault lock..." Action="Vault.RemoveLock"/>
	<ContextLine/>
	<ContextButton Text="Add referenced vault..." Action="Vault.AddReference"/>
	<ContextButton Text="Close vault" Action="Vault.Close"/>
</ContextMenu>
