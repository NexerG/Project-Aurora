<?xml version="1.0" encoding="utf-8"?>
<ContextMenu>
	<ContextButton Text="Open as planner" Action="Notes.OpenNormally"/>
	<ContextSubmenu Text="Add to sticky note" Source="vault-stickies"/>
	<ContextLine/>
	<ContextSubmenu Text="New">
		<ContextButton Text="Folder" Action="Folders.NewHere"/>
		<ContextButton Text="Doc" Action="Notes.NewHere"/>
		<ContextSubmenu Text="Sheet">
			<ContextButton Text="Fixed size" Action="Sheets.NewFixedHere"/>
			<ContextButton Text="Unfixed" Action="Sheets.NewHere"/>
		</ContextSubmenu>
		<ContextButton Text="Planner" Action="Planners.NewHere"/>
	</ContextSubmenu>
	<ContextButton Text="Rename note" Action="Notes.Rename"/>
	<ContextButton Text="Duplicate note" Action="Notes.Duplicate"/>
	<ContextLine/>
	<ContextButton Text="Delete note" Action="Notes.Delete"/>
</ContextMenu>
