		<ContextButton Text="Planner" Action="Planners.New"/>
		<ContextButton Text="Graph" Action="Graphs.New"/>
	</ContextSubmenu>
	<ContextButton Text="Vaults" Action="Vaults.Open"/>
	<ContextButton Text="Save note" Action="Text.Save"/>
	<ContextButton Text="Export PDF" Action="Tex.ExportPdf"/>
</ContextMenu>
