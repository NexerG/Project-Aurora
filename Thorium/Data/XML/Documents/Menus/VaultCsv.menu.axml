<?xml version="1.0" encoding="utf-8"?>
<ContextMenu>
	<ContextSubmenu Text="Add to sticky note" Source="vault-stickies"/>
	<ContextLine/>
	<ContextButton Text="Create a sheet from this" Action="Sheets.FromCsv"/>
	<ContextButton Text="Convert to sheet" Action="Sheets.ConvertCsv"/>
	<ContextLine/>
	<ContextSubmenu Text="New">
		<ContextButton Text="Folder" Action="Folders.NewHere"/>
		<ContextButton Text="Doc" Action="Notes.NewHere"/>
		<ContextSubmenu Text="Sheet">
			<ContextButton Text="Fixed size" Action="Sheets.NewFixedHere"/>
			<ContextButton Text="Unfixed" Action="Sheets.NewHere"/>
		</ContextSubmenu>
		<ContextButton Text="Planner" Action="Planners.NewHere"/>
	</ContextSubmenu>
	<ContextButton Text="Rename" Action="Notes.Rename"/>
	<ContextButton Text="Duplicate" Action="Notes.Duplicate"/>
	<ContextLine/>
	<ContextButton Text="Delete" Action="Notes.Delete"/>
</ContextMenu>
