<?xml version="1.0" encoding="utf-8" ?>
<Animations xmlns="http://arctisaurora/AuroraAnimationTypes"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			xsi:schemaLocation="http://arctisaurora/AuroraAnimationTypes ../../Schemas/AnimationTypeSchema.xsd" >

	<Clip Name="accent-grow">
		<Track Property="Height">
			<Key Time="0" Value="0" Ease="BackOut"/>
			<Key Time="0.4" Value="14"/>
		</Track>
	</Clip>

	<Binding Name="chrome-press">
		<BindingTrack Property="EdgeThickness" Rest="0,0,0,0" Hover="0,0,1,0" Press="0,0,2,0"/>
	</Binding>

</Animations>
