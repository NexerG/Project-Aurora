<?xml version="1.0" encoding="utf-8" ?>
<KeybindMap xmlns="http://arctisaurora/AuroraInputTypes"
		  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		  xsi:schemaLocation="http://arctisaurora/AuroraInputTypes ../../Schemas/InputTypeSchema.xsd" >
	<NamedModifier Modifier="Extend" Key="LeftShift" />
	<NamedModifier Modifier="Extend" Key="RightShift" />
	<NamedModifier Modifier="Word" Key="LeftControl" />
	<NamedModifier Modifier="Word" Key="RightControl" />
	<NamedModifier Modifier="Copy" Key="LeftControl" />
	<NamedModifier Modifier="Copy" Key="RightControl" />
	<NamedModifier Modifier="Zoom" Key="LeftControl" />
	<NamedModifier Modifier="Zoom" Key="RightControl" />

	<Keybind Trigger="AnySymbol" Action="Text.Write">
		<Continuous />
	</Keybind>

	<Keybind Trigger="Backspace" Action="Text.Backspace">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Delete" Action="Text.Delete">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Enter" Action="Text.NewBlock">
		<Repeat />
	</Keybind>

	<Keybind Trigger="NumpadEnter" Action="Text.NewBlock">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Tab" Action="Text.Outdent">
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="Tab" Action="Text.Indent">
		<Press />
	</Keybind>

	<Keybind Trigger="Escape" Action="Text.Cancel">
		<Press />
	</Keybind>

	<Keybind Trigger="N" Action="Notes.New">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="S" Action="Text.Save">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<!-- Ctrl+Shift+Z binds are declared ahead of their Ctrl+Z binds -->
	<Keybind Trigger="Z" Action="Text.Redo">
		<Modifier Key="LeftControl" />
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="Z" Action="Text.Undo">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Y" Action="Text.Redo">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="A" Action="Text.SelectAll">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="U" Action="Text.Underline">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="L" Action="Text.AlignLeft">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="E" Action="Text.AlignCenter">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="R" Action="Text.AlignRight">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="J" Action="Text.AlignJustify">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="C" Action="Text.Copy">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="X" Action="Text.Cut">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="V" Action="Sheet.PasteLink">
		<Modifier Key="LeftControl" />
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="V" Action="Text.Paste">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="B" Action="Text.Bold">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="B" Action="Sheet.Bold">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="I" Action="Text.Italic">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="M" Action="Math.InsertDisplay">
		<Modifier Key="LeftControl" />
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="M" Action="Math.Insert">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Left" Action="Text.CaretLeft">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Right" Action="Text.CaretRight">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Up" Action="Text.CaretUp">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Down" Action="Text.CaretDown">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Home" Action="Text.CaretLineStart">
		<Press />
	</Keybind>

	<Keybind Trigger="End" Action="Text.CaretLineEnd">
		<Press />
	</Keybind>

	<Keybind Trigger="PageUp" Action="Text.CaretPageUp">
		<Repeat />
	</Keybind>

	<Keybind Trigger="PageDown" Action="Text.CaretPageDown">
		<Repeat />
	</Keybind>

	<!-- sheets: each action does nothing unless a sheet holds the active control -->
	<Keybind Trigger="AnySymbol" Action="Sheet.Write">
		<Continuous />
	</Keybind>

	<Keybind Trigger="Left" Action="Sheet.Left">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Right" Action="Sheet.Right">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Up" Action="Sheet.Up">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Down" Action="Sheet.Down">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Enter" Action="Sheet.Enter">
		<Repeat />
	</Keybind>

	<Keybind Trigger="NumpadEnter" Action="Sheet.Enter">
		<Repeat />
	</Keybind>

	<Keybind Trigger="Tab" Action="Sheet.TabBack">
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="Tab" Action="Sheet.Tab">
		<Press />
	</Keybind>

	<Keybind Trigger="F2" Action="Sheet.Edit">
		<Press />
	</Keybind>

	<Keybind Trigger="Delete" Action="Sheet.Clear">
		<Press />
	</Keybind>

	<Keybind Trigger="Backspace" Action="Sheet.Clear">
		<Press />
	</Keybind>

	<Keybind Trigger="Z" Action="Sheet.Redo">
		<Modifier Key="LeftControl" />
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="Z" Action="Sheet.Undo">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Y" Action="Sheet.Redo">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Delete" Action="Planner.Delete">
		<Press />
	</Keybind>

	<Keybind Trigger="Z" Action="Planner.Redo">
		<Modifier Key="LeftControl" />
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="Z" Action="Planner.Undo">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Y" Action="Planner.Redo">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="S" Action="Planner.Save">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="S" Action="Sheet.Save">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="A" Action="Sheet.SelectAll">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<!-- the two-modifier bind is declared first: IsShadowed only suppresses the looser bind once the
	     stricter one has already fired this pass -->
	<Keybind Trigger="Backslash" Action="View.SplitDown">
		<Modifier Key="LeftControl" />
		<Modifier Key="LeftShift" />
		<Press />
	</Keybind>

	<Keybind Trigger="Backslash" Action="View.SplitRight">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="F9" Action="Profiling.Capture">
		<Press />
	</Keybind>

	<Keybind Trigger="F10" Action="UI.DumpTree">
		<Press />
	</Keybind>

	<Keybind Trigger="GraveAccent" Action="Console.Toggle">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Equal" Action="UI.ZoomIn">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Minus" Action="UI.ZoomOut">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

	<Keybind Trigger="Num0" Action="UI.ZoomReset">
		<Modifier Key="LeftControl" />
		<Press />
	</Keybind>

</KeybindMap>