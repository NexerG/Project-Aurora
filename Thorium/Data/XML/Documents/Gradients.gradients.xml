<?xml version="1.0" encoding="utf-8" ?>
<Gradients xmlns="http://arctisaurora/AuroraUITypes"
		   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xsi:schemaLocation="http://arctisaurora/AuroraUITypes ../Schemas/UITypeSchema.xsd" >

	<Gradient Name="titlebar" Angle="90">
		<Stop Color="#F0EFEA" Pos="0"/>
		<Stop Color="#EBEAE5" Pos="1"/>
	</Gradient>

	<Gradient Name="accent" Angle="0">
		<Stop Color="#3A3833" Pos="0"/>
		<Stop Color="#23221E" Pos="1"/>
	</Gradient>

	<Gradient Name="glow" Kind="Radial" CenterX="0.5" CenterY="0.5">
		<Stop Color="#3A6EA5" Alpha="0.55" Pos="0"/>
		<Stop Color="#3A6EA5" Alpha="0" Pos="1"/>
	</Gradient>

</Gradients>
