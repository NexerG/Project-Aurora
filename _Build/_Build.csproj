<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuroraEditor\AuroraEditor.csproj" />
    <ProjectReference Include="..\AuroraEngine\AuroraEngine.csproj" />
    <ProjectReference Include="..\Thorium\Thorium.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="&quot;$(ProjectDir)GenerateNamespaces.cmd&quot; &quot;$(SolutionDir)..\&quot;" />
  </Target>

</Project>
